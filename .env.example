# Database (SQLite | Azure / SQL Server, required at runtime)
# Opciones: sqlite | azure
DB_TYPE=sqlite
SQLITE_DB_PATH=data/database.sqlite3
# Only for SQL Server type connection
DB_SERVER=
DB_PORT=
DB_DATABASE=
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=
DB_TRUST_SERVER_CERTIFICATE=
# JWT (required; use a random, long value)
JWT_SECRET=
ENCRYPTER_KEY=
JWT_ISSUER=
JWT_SUBJECT=
JWT_EXPIRATION_MINUTES=
PORT=3000
NODE_ENV=production
# Logging level: 'info' | 'warn' | 'error' (defaults to 'warn' in production, 'info' in development)
LOG_LEVEL=info
# Debug mode: 'true' to print full error stack traces to console, 'false' to suppress traces in production
DEBUG=false
# New Relic Dashboard Monitoring
NEW_RELIC_APP_NAME=
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_LOG=logs/newrelic_agent.log
